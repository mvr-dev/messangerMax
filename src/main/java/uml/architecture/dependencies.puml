@startuml ClassDependencies

package "Core Dependencies" {
  [UserService] --> [UserRepository]
  [MessageService] --> [MessageRepository]
  [MessageService] --> [UserService]
  [MessageService] --> [ChatRoomService]
  [ChatRoomService] --> [ChatRoomRepository]
  [ChatRoomService] --> [MembershipRepository]
  [AuthService] --> [UserService]
}

package "API Layer Dependencies" {
  [UserController] --> [UserService]
  [MessageController] --> [MessageService]
  [ChatRoomController] --> [ChatRoomService]
  [AuthController] --> [AuthService]
}

package "Data Flow" {
  [UserRepository] --> [User]
  [MessageRepository] --> [Message]
  [ChatRoomRepository] --> [ChatRoom]
  [MembershipRepository] --> [Membership]

  [UserService] --> [User]
  [MessageService] --> [Message]
  [ChatRoomService] --> [ChatRoom]
  [ChatRoomService] --> [Membership]
}

package "DTO Conversions" {
  [UserController] --> [UserDTO]
  [MessageController] --> [MessageDTO]
  [MessageController] --> [CreateMessageRequest]
  [ChatRoomController] --> [ChatRoomDTO]
  [AuthController] --> [LoginRequest]
  [AuthController] --> [AuthResponse]

  [User] ..> [UserDTO] : maps to
  [Message] ..> [MessageDTO] : maps to
  [ChatRoom] ..> [ChatRoomDTO] : maps to
}

package "Business Logic" {
  [AuthService] --> [JWTUtil]
  [AuthService] --> [PasswordEncoder]
  [UserService] --> [PasswordEncoder]
}

note top of [MessageService]
  Depends on UserService and
  ChatRoomService for validation
  and business rules
end note

note right of [ChatRoomService]
  Manages room memberships
  and access control
end note

@enduml